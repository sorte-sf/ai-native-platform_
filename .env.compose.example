# Copy to .env. Set IMAGE_TAG to the branch or version published in GHCR.
IMAGE_TAG=latest

# Use simple alphanumeric values for PostgreSQL/RabbitMQ passwords so the
# generated connection strings and AMQP URI don't need escaping.
POSTGRES_USER=sorte
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_secret
RABBITMQ_USER=sorte
RABBITMQ_PASSWORD=replace_with_a_long_random_alphanumeric_secret
JWT_SIGNING_KEY=replace_with_at_least_32_random_characters

N8N_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
N8N_OWNER_EMAIL=admin@example.com
# Provide the bcrypt password hash required by n8n's owner-managed-by-env mode.
N8N_OWNER_PASSWORD_HASH=replace_with_n8n_bcrypt_hash
N8N_WEBHOOK_URL=http://your-server-hostname:5678/

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_long_random_password

# Host ports can be changed if these ports are already in use.
GATEWAY_PORT=11000
WEBSITE_PORT=9009
PORTAL_WEB_PORT=9008
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OLLAMA_PORT=11434
REDIS_INSIGHT_PORT=5540
REDIS_COMMANDER_PORT=8081
N8N_PORT=5678
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443
PGADMIN_PORT=5050
