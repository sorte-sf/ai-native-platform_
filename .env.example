# Copy this file to .env and replace every placeholder with a strong, unique secret.
IMAGE_TAG=latest

# Shared application token signing key. Keep identical across the platform services.
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Stable, separate AES key for Builder credential encryption (16, 24, or 32 UTF-8 bytes).
BUILDER_ENCRYPTION_KEY=replace-with-a-separate-exactly-32-byte-key

# PostgreSQL shared login (separate databases are created by the Compose services).
POSTGRES_USER=sorte_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# RabbitMQ service credentials.
RABBITMQ_USER=sorte_app
RABBITMQ_PASSWORD=replace-with-a-long-random-password

# Public origin(s) allowed to call the API gateway from a browser.
# Use exact origins (scheme + host + optional port), without a trailing slash.
# Add tenant-hosted app origins in slots 1-4. Wildcard origins are intentionally unsupported.
CORS_ORIGIN_0=https://builder.example.com
CORS_ORIGIN_1=
CORS_ORIGIN_2=
CORS_ORIGIN_3=
CORS_ORIGIN_4=

# pgAdmin and optional operations dashboards
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
PGADMIN_PORT=5050
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443
REDIS_INSIGHT_PORT=5540
REDIS_COMMANDER_PORT=8081
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OLLAMA_PORT=11434
# AI generation timeout seconds (local: 60-3600, cloud: 30-1800).
AI_LOCAL_REQUEST_TIMEOUT_SECONDS=900
AI_CLOUD_REQUEST_TIMEOUT_SECONDS=300
GATEWAY_PORT=11000
PORTAL_WEB_PORT=9008
WEBSITE_PORT=9009

# n8n is optional; retain these strong secrets if the service is enabled.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD_HASH=replace-with-a-valid-n8n-password-hash
N8N_PORT=5678
N8N_WEBHOOK_URL=https://n8n.example.com/

# Private GHCR images: authenticate Docker to ghcr.io before running Compose.
# Never put a GitHub token in this file.
